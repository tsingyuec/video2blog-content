# 只版本化「博客」与「视频演说图文稿」；视频、抽帧、字幕、元数据、工具等
# 均由处理流程可再生，或属本地环境，不入库。
# content 下允许「系列」直接位于 content/ 下，也允许再套一层分组目录（如 content/vllm_group/vllm）。

# 1) 先忽略 content 下的一切
content/**/*

# 2) 反向保留各级目录本身（否则 Git 不会向下查找）
!content/**/

# 3) 反向保留各级视频索引 README（系列 / 分组）
!content/**/README.md

# 4) 反向保留「博客」（含配图 assets/）
!content/**/blog/
!content/**/blog/**

# 5) 反向保留「视频演说图文稿」（含代表帧 img/）
# !content/**/transcripts/
# !content/**/transcripts/**

# 6) 反向保留各系列「配套代码」目录 code/（虚拟环境与 Python 缓存仍忽略）
!content/**/code/
!content/**/code/**
content/**/code/.venv/
content/**/code/**/__pycache__/
content/**/code/**/*.py[cod]
content/**/code/**/*.cif

# 7) 反向保留「扁平分组」：biomodel / biodata / biobasic 下的博客与配图
#    （这些主题子目录内不再有 README.md 与 blog/，博客直接落在子目录里）
!content/biomodel/
!content/biomodel/**
!content/biodata/
!content/biodata/**
!content/biobasic/
!content/biobasic/**
# 其中子目录下的 transcripts/ 仍不收录
content/biomodel/**/transcripts/
content/biobasic/**/transcripts/

# 项目内工具（多 P 封装等）与临时目录
/tools/
**/_work/

# 站点构建产物（由 scripts/build_site.py 与 mkdocs 生成）
/build/
/site/
